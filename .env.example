# Copy to .env. Never put a real key in chat, git, or frontend variables.
OPENAI_API_KEY=
OPENAI_TUTOR_MODEL=gpt-6-luna
# One shared server-side key. No automatic paid calls on page load.
AI_PAID_CALLS_ENABLED=false
AI_EXECUTION_MODE=offline
AI_SESSION_BUDGET_USD=0.10
AI_DAILY_BUDGET_USD=0.25
AI_MONTHLY_BUDGET_USD=2.00
